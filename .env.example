# ==============================================================================
# Haifa Agent Evaluation Control Plane (evalctl) Environment Template
# 复制本文件为 .env 并填写实际值（.env 文件已加入 .gitignore，严禁提交真实密钥到版本库）
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 目标评测主机 SSH 连接凭据 (仅存在于操作者本机)
# ------------------------------------------------------------------------------
# 目标 Ubuntu 主机的 SSH 私钥绝对路径（Windows 路径或 POSIX 路径均可）
HAIFA_EVAL_HOST_SSH_KEY_FILE="D:\workspace\haifa-remote\haifa-agent-tmp.pem"

# ------------------------------------------------------------------------------
# 2. GitHub 源码拉取凭据 (专用只读机器身份 / Deploy Key)
# ------------------------------------------------------------------------------
# 用于在远端临时拉取 product、docs、testConfig 三个仓库的专用只读私钥
# 必须与 Host SSH 私钥严格分离，检出并校验 SHA 完成后远端副本会立即自毁
HAIFA_EVAL_GITHUB_SSH_KEY_FILE="C:\Users\wangr\.ssh\id_rsa_github_readonly"

# ------------------------------------------------------------------------------
# 3. 模型 Provider 与第三方服务 API Keys
# ------------------------------------------------------------------------------
# 依据 Run Request 中 evaluation.requiredSecretEnvironmentNames 声明的项进行配置
# 评测运行阶段仅通过 SSH stdin 写入远端 tmpfs /run/haifa-eval/<runId>/secrets.env (0600)
# 评测结束后自动销毁，绝不落盘、不打印、不进入日志

# 智谱 BigModel API Key (GLM-5.3-Flash / GLM-4 等)
BIGMODEL_API_KEY="your-zhipu-bigmodel-api-key-here"

# 阿里云 IQS API Key (Web 检索增强 Provider，如有需要)
ALIYUN_IQS_API_KEY="your-aliyun-iqs-api-key-here"

# 其它备选 Provider (按需配置)
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# OPENAI_API_KEY="your-openai-api-key"
